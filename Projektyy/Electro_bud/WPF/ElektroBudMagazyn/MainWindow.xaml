<Window x:Class="ElektroBudMagazyn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Magazyn Elektrobud" Height="650" Width="600">
    <!--Ten kod wyświtla produkty w magazynie-->
    <StackPanel Margin="10">

        <TextBlock Text="Dodawanie produktów" FontWeight="Bold" Margin="0,0,0,15"/>

        <Border BorderBrush="Black" BorderThickness="0.4"  Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="1">
                    <TextBlock Text="nazwa" FontWeight="Bold" Width="44" HorizontalAlignment="Left"/>
                    <TextBox x:Name="nazwa" Width="100" BorderBrush="Black" BorderThickness="1"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="1">
                    <TextBlock Text="Kategoria" FontWeight="Bold" Width="auto" HorizontalAlignment="Left"/>
                    <TextBox x:Name="kategoria" Width="100" BorderBrush="Black" BorderThickness="1"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="1">
                    <TextBlock Text= "Kod EAN" FontWeight="Bold" Width="auto" HorizontalAlignment="Left"/>
                    <TextBox x:Name="Ean" Width="100" BorderBrush="Black" BorderThickness="1"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="1">
                    <TextBlock Text="Lokalizacja" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="lokalizacja" Width="100">
                        <ComboBoxItem Content="N (Nie wiem)"/>
                        <ComboBoxItem Content="R (Regal)"/>
                        <ComboBoxItem Content="P (Pólka)"/>
                    </ComboBox>
                </StackPanel>
                <Button Content="dodaj produkt" Click="Add_Click" Width="100" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>

        <Border BorderBrush="Black" BorderThickness="1" Margin="0,0,0,10">
            <StackPanel x:Name="Container" Margin="5">
                <TextBlock Text="Dodane Produkty:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
            </StackPanel>
        </Border>

    </StackPanel>
</Window>